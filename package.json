{
  "name": "@linepogl/apiquity",
  "version": "0.1.0",
  "description": "A web component that displays OpenAPI and AsyncAPI documents.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/linepogl/apiquity.git"
  },
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": "./dist/apiquity.js",
  "module": "./dist/apiquity.js",
  "unpkg": "./dist/apiquity.js",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "start": "node server/server.ts spec/openapi.json spec/asyncapi.yaml",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm run build"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.6",
    "@types/node": "^26.6.6",
    "js-yaml": "5.5.0",
    "preact": "^11.2.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
